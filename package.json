{
  "name": "trash",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build && esbuild src/server/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "test": "vitest run",
    "check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:visual": "npm run build && playwright test",
    "test:visual:update": "npm run build && playwright test --update-snapshots",
    "test:all": "npm run check && vitest run && npm run test:visual"
  },
  "dependencies": {
    "postgres": "^4.1.1",
    "web-push": "^4.0.0",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
